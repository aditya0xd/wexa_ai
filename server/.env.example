# ── CognoDB Connection ──────────────────────────────────────
# Get these from https://console.cognodb.com after creating a free (c0) instance.
# The password is shown exactly once at creation — copy it immediately.

COGNODB_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<your-generated-password>

# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
